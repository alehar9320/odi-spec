{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Jobs-To-Be-Done",
	"scopeName": "source.jtbd",
	"fileTypes": [
		"jtbd"
	],
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#headings" },
		{ "include": "#fields" },
		{ "include": "#lists" },
		{ "include": "#metrics" },
		{ "include": "#strings" },
		{ "include": "#inline" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.jtbd",
					"match": "^\\s*(?:#|//).*"
				},
				{
					"name": "comment.block.jtbd",
					"begin": "/\\*",
					"end": "\\*/"
				}
			]
		},
		"headings": {
			"patterns": [
				{
					"name": "entity.name.section.jtbd",
					"match": "^\\s{0,3}(#{1,6})\\s+(.+)$"
				},
				{
					"name": "entity.name.section.jtbd",
					"match": "^\\s*([A-Z][A-Za-z0-9 \\\-,]{0,80})\\s*$"
				}
			]
		},
		"fields": {
			"patterns": [
				{
					"name": "meta.field.jtbd",
					"begin": "(?i)^\\s*([A-Za-z][A-Za-z \\\-_]{0,40})\\s*:\\s*",
					"beginCaptures": {
						"1": { "name": "entity.name.tag.jtbd" }
					},
					"end": "(?m)(?=^\\s*$|^\\s*[A-Za-z][A-Za-z \\\-_]{0,40}\\s*:\\s|^\\s{0,3}#{1,6}\\s+|\\z)",
					"patterns": [
						{
							"name": "string.unquoted.jtbd",
							"match": ".+"
						},
						{
							"name": "constant.numeric.percentage.jtbd",
							"match": "\\b\\d{1,3}(?:\\.\\d+)?%\\b"
						},
						{
							"name": "constant.numeric.scale.jtbd",
							"match": "\\b\\d+(?:\\.\\d+)?\\s*(?:/\\s*10|of\\s*10|out\\s*of\\s*10)|\\b\\d(?:\\.\\d)?/10\\b"
						},
						{
							"name": "constant.numeric.jtbd",
							"match": "\\b\\d+(?:\\.\\d+)?\\b"
						}
					]
				}
			]
		},
		"lists": {
			"patterns": [
				{
					"name": "markup.list.jtbd",
					"match": "^\\s*([-*+]\\s+|\\d+\\.\\s+).+"
				}
			]
		},
		"metrics": {
			"patterns": [
				{
					"name": "constant.numeric.percentage.jtbd",
					"match": "\\b\\d{1,3}(?:\\.\\d+)?%\\b"
				},
				{
					"name": "constant.numeric.jtbd",
					"match": "\\b\\d+(?:\\.\\d+)?\\b"
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.jtbd",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.jtbd",
					"match": "\\\\."
				}
			]
		},
		"inline": {
			"patterns": [
				{
					"name": "markup.inline.raw.jtbd",
					"match": "`[^`]+`"
				},
				{
					"name": "markup.quote.jtbd",
					"match": "^\\s*>\\s.*"
				},
				{
					"name": "storage.type.status.jtbd",
							"match": "(?i)\\b(?:Job|Outcome|Importance|Satisfaction|Metric|Context)\\b(?=\\s*:)"
				}
			]
		}
	}

}